# Multi-stage Dockerfile for a production-ready Clojure (Pedestal/Jetty) application
# Uses Leiningen for robust dependency management and JRE-slim images for optimal runtime performance

# Stage 1: Base stage - common foundation for Leiningen and Java 21
FROM clojure:temurin-21-lein-trixie AS base

# Stage 2: Builder stage - compile the application into a standalone Überjar
FROM base AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy only the project definition to leverage Docker layer caching
# This prevents re-downloading dependencies if only source code changes
COPY project.clj ./

# Pre-fetch project dependencies using a cache mount for the local Maven repository
# This significantly speeds up subsequent builds
RUN --mount=type=cache,target=/root/.m2 \
    lein deps

# Copy the rest of the application source code
COPY . .

# Build the standalone Überjar:
# - 'lein uberjar' compiles the code (AOT) and packages it with all dependencies
# - We rename the resulting file to 'app.jar' for a consistent path in the runtime stage
RUN --mount=type=cache,target=/root/.m2 \
    lein uberjar && \
    mv target/uberjar/backend-*-standalone.jar app.jar

# Stage 3: Runtime stage - minimal image for production deployment
FROM clojure:temurin-21-lein-trixie-slim AS runtime

# Install minimal runtime dependencies
# - curl: useful for health checks and network debugging
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Set application directory
WORKDIR /app

# Copy only the compiled Überjar from the builder stage
COPY --from=builder /app/app.jar ./

# Configure production JVM settings:
# - MaxRAMPercentage: Dynamically allocates heap (best for Render/PaaS)
# - PORT: Default for local, overridden by Render's environment
ENV PORT=8080 \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"

# Expose the application port
EXPOSE 8080

# Final command: Execute migrations and then start the Pedestal server
# 1. Runs 'java -jar app.jar migrate' to trigger your (run-migrations) logic
# 2. If migration returns exit code 0, 'exec' replaces the shell with the server process
# 3. 'exec' is critical for proper signal handling (SIGTERM) during deployments

CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar migrate && exec java $JAVA_OPTS -jar app.jar"]