# Multi-stage Dockerfile for a production-ready Clojure (Pedestal/Jetty) application
# Uses Leiningen for robust dependency management and JRE-slim images for optimal runtime performance

# Stage 1: Base stage - common foundation ensuring consistent Java and Leiningen versions
FROM clojure:temurin-17-lein-bookworm AS base

# Stage 2: Builder stage - resolve dependencies and compile the AOT Uberjar
FROM base AS builder

# Optimize JVM build performance:
# - Use the Maven local repository cache mount to avoid re-downloading JARs
# - Ahead-of-Time (AOT) compilation for faster production startup
WORKDIR /app

# Copy only the project definition file first to maximize Docker layer caching
# Changing source code won't invalidate the expensive 'lein deps' step
COPY project.clj ./

# Install project dependencies
# Uses cache mount for the .m2 repository to dramatically speed up repeated builds
RUN --mount=type=cache,target=/root/.m2 \
    lein deps

# Copy the full application source code
COPY . ./

# Build the standalone Uberjar (executable JAR containing app + all dependencies)
# Again using cache mount for performance during compilation
RUN --mount=type=cache,target=/root/.m2 \
    lein uberjar && \
    mv target/*-standalone.jar app.jar

# Stage 3: Runtime stage - minimal final image for production deployment
FROM eclipse-temurin:17-jre-jammy AS runtime

# Install only essential runtime system dependencies
# Using the JRE variant significantly reduces image size and security surface area
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Set application directory
WORKDIR /app

# Copy only the compiled Uberjar from the builder stage
COPY --from=builder /app/app.jar ./

# Configure production JVM settings:
# - UseContainerSupport: Ensures JVM respects Docker memory limits
# - MaxRAMPercentage: Dynamically allocates heap based on container size (crucial for Render/PaaS)
ENV PORT=8000 \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"

# Expose the port the application will run on (default 8000, overridable via $PORT)
EXPOSE 8000

# Final command: Start the Clojure application
# - Uses 'exec' to properly forward signals (e.g., SIGTERM for graceful shutdown)
# - The entry point handles both Datomic schema migrations and the Pedestal server
# - Supports $PORT environment variable for platforms like Render
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]